generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRADER
  ADMIN
}

enum OrderType {
  BUY
  SELL
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  username     String        @unique
  password     String
  role         Role          @default(TRADER)
  virtualCash  Float         @default(100000.0)
  holdings     Holding[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Holding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  assetType String
  quantity  Int
  avgPrice  Float
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
}

model Transaction {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  type      OrderType
  quantity  Int
  price     Float
  total     Float
  createdAt DateTime  @default(now())
}